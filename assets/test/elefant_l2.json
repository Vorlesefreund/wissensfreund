  "sections": [
    {
      "id": "s1",
      "heading": "Was ist ein Elefant?",
      "section_role": "intro",
      "sentences": [
        {
          "id": "s1_0",
          "text": "Elefanten sind die größten Tiere, die auf dem Land leben.",
          "img_index": 0
        },
        {
          "id": "s1_1",
          "text": "Ein ausgewachsener Elefant kann so schwer sein wie fünf Autos zusammen.",
          "img_index": -1
        },
        {
          "id": "s1_2",
          "text": "Elefanten haben eine dicke, graue Haut, die wie ein Schutzanzug wirkt.",
          "img_index": -1
        },
        {
          "id": "s1_3",
          "text": "Ihre großen Ohren helfen ihnen, sich an heißen Tagen abzukühlen.",
          "img_index": -1
        }
      ],
      "boxes": [],
      "table": null
    },
    {
      "id": "s2",
      "heading": "Der Rüssel – das Wunderwerkzeug",
      "section_role": "main",
      "sentences": [
        {
          "id": "s2_0",
          "text": "Der Rüssel ist das wichtigste Körperteil des Elefanten.",
          "img_index": 2
        },
        {
          "id": "s2_1",
          "text": "Er besteht aus über 40.000 einzelnen Muskeln und ist unglaublich beweglich.",
          "img_index": -1
        },
        {
          "id": "s2_2",
          "text": "Mit dem Rüssel können Elefanten Wasser aufsaugen und in den Mund spritzen.",
          "img_index": -1
        },
        {
          "id": "s2_3",
          "text": "Sie nutzen ihn auch, um Gras zu greifen, Bäume umzuwerfen oder sich gegenseitig zu berühren.",
          "img_index": -1
        },
        {
          "id": "s2_4",
          "text": "Elefantenbabys lernen erst nach und nach, ihren Rüssel richtig zu benutzen.",
          "img_index": -1
        }
      ],
      "boxes": [],
      "table": null
    },
    {
      "id": "s3",
      "heading": "Leben in der Herde",
      "section_role": "main",
      "sentences": [
        {
          "id": "s3_0",
          "text": "Elefanten leben immer in Gruppen, die man Herden nennt.",
          "img_index": 1
        },
        {
          "id": "s3_1",
          "text": "Eine Herde besteht meistens aus Müttern, Töchtern und Jungtieren.",
          "img_index": -1
        },
        {
          "id": "s3_2",
          "text": "Die älteste und erfahrenste Elefantenmutter führt die Herde an.",
          "img_index": -1
        },
        {
          "id": "s3_3",
          "text": "Sie kennt die besten Wasserstellen und zeigt den anderen, wohin sie wandern sollen.",
          "img_index": -1
        },
        {
          "id": "s3_4",
          "text": "Elefanten sind sehr fürsorglich und helfen sich gegenseitig in Gefahr.",
          "img_index": -1
        }
      ],
      "boxes": [],
      "table": null
    },
    {
      "id": "s4",
      "heading": "Afrikanisch oder Asiatisch?",
      "section_role": "main",
      "sentences": [
        {
          "id": "s4_0",
          "text": "Es gibt zwei Arten von Elefanten: den Afrikanischen und den Asiatischen Elefanten.",
          "img_index": 3
        },
        {
          "id": "s4_1",
          "text": "Der Afrikanische Elefant ist größer und hat viel größere Ohren.",
          "img_index": -1
        },
        {
          "id": "s4_2",
          "text": "Beim Asiatischen Elefanten ist der Kopf oben abgerundet und die Ohren sind kleiner.",
          "img_index": -1
        },
        {
          "id": "s4_3",
          "text": "Beide Arten leben in heißen Gebieten – Afrikaner in der Savanne, Asiaten im Dschungel.",
          "img_index": -1
        }
      ],
      "boxes": [],
      "table": null
    },
    {
      "id": "s5",
      "heading": "Elefantenbabys",
      "section_role": "main",
      "sentences": [
        {
          "id": "s5_0",
          "text": "Ein Elefantenbaby wächst fast zwei Jahre im Bauch der Mutter heran.",
          "img_index": 4
        },
        {
          "id": "s5_1",
          "text": "Bei der Geburt wiegt es bereits rund 100 Kilogramm.",
          "img_index": -1
        },
        {
          "id": "s5_2",
          "text": "Die ganze Herde kümmert sich um das Neugeborene und beschützt es.",
          "img_index": -1
        },
        {
          "id": "s5_3",
          "text": "Junge Elefanten spielen gerne miteinander und lernen dabei, wie das Leben in der Herde funktioniert.",
          "img_index": -1
        },
        {
          "id": "s5_4",
          "text": "Elefanten können bis zu 70 Jahre alt werden – sie sind echte Langläufer unter den Tieren.",
          "img_index": -1
        }
      ],
      "boxes": [],
      "table": null
    }
  ],
