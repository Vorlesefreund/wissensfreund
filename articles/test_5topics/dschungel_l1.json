  "sections": [
    {
      "id": "sec1",
      "heading": "Ein Wald voller Leben",
      "section_role": "intro",
      "sentences": [
        {
          "id": "s001",
          "text": "Stell dir vor, du bist in einem riesigen, grünen Wald, wo es fast jeden Tag regnet und ganz viele Tiere leben.",
          "img_index": -1
        },
        {
          "id": "s002",
          "text": "So ist der tropische Regenwald!",
          "img_index": -1
        },
        {
          "id": "s003",
          "text": "Er ist sehr warm, wie im Sommerurlaub.",
          "img_index": -1
        },
        {
          "id": "s004",
          "text": "Die Bäume sind immer grün und wachsen sehr hoch zum Himmel.",
          "img_index": -1
        },
        {
          "id": "s005",
          "text": "Es gibt dort so viele verschiedene Tiere und Pflanzen wie nirgendwo sonst auf der Erde.",
          "img_index": -1
        }
      ],
      "boxes": [],
      "table": null
    },
    {
      "id": "sec2",
      "heading": "Regen, Regen, jeden Tag",
      "section_role": "appearance_equipment",
      "sentences": [
        {
          "id": "s006",
          "text": "Im Regenwald regnet es fast jeden Nachmittag.",
          "img_index": -1
        },
        {
          "id": "s007",
          "text": "Manchmal gibt es auch ein kleines Gewitter dazu.",
          "img_index": -1
        },
        {
          "id": "s008",
          "text": "Deshalb ist alles immer feucht und grün.",
          "img_index": -1
        },
        {
          "id": "s009",
          "text": "Die Pflanzen saugen das Wasser auf und geben es wieder in die Luft ab.",
          "img_index": -1
        },
        {
          "id": "s010",
          "text": "So entstehen neue Wolken und es regnet wieder.",
          "img_index": -1
        }
      ],
      "boxes": [],
      "table": null
    },
    {
      "id": "sec3",
      "heading": "Ein Zuhause für viele Tiere",
      "section_role": "behavior_life",
      "sentences": [
        {
          "id": "s011",
          "text": "Der Regenwald ist wie ein großes Haus mit vielen Stockwerken.",
          "img_index": -1
        },
        {
          "id": "s012",
          "text": "Ganz unten auf dem Boden leben kleine Tiere wie Käfer und Spinnen.",
          "img_index": -1
        },
        {
          "id": "s013",
          "text": "Etwas höher klettern Affen herum und bunte Vögel fliegen von Ast zu Ast.",
          "img_index": -1
        },
        {
          "id": "s014",
          "text": "Ganz oben in den Baumwipfeln wohnen Tiere, die fast nie den Boden berühren.",
          "img_index": -1
        },
        {
          "id": "s015",
          "text": "Auch Menschen leben in diesen Wäldern und passen gut auf sie auf.",
          "img_index": -1
        }
      ],
      "boxes": [
        {
          "type": "warnung",
          "text": "⚠️ Leider wird der Regenwald immer kleiner, weil Menschen Bäume fällen. Viele Tiere verlieren dann ihr Zuhause."
        }
      ],
      "table": null
    },
    {
      "id": "sec4",
      "heading": "Wusstest du schon?",
      "section_role": "curiosity",
      "sentences": [
        {
          "id": "s016",
          "text": "In den Regenwäldern gibt es die größten Flüsse der Welt, wie den Amazonas in Südamerika.",
          "img_index": -1
        },
        {
          "id": "s017",
          "text": "Dort schwimmen besondere Fische und sogar Flussdelfine.",
          "img_index": -1
        }
      ],
      "boxes": [
        {
          "type": "wow",
          "text": "🌟 Ein einziger Baum im Regenwald kann an einem Tag so viel Wasser in die Luft abgeben, wie in 300 großen Flaschen ist!"
        }
      ],
      "table": null
    }
  ],
