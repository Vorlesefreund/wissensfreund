  "sections": [
    {
      "id": "sec1",
      "heading": "Was sind Bienen?",
      "section_role": "intro",
      "sentences": [
        {
          "id": "s001",
          "text": "Summ, summ, summ! Wenn du eine Biene siehst, ist sie bestimmt ganz fleißig.",
          "img_index": 0
        },
        {
          "id": "s002",
          "text": "Bienen fliegen von Blume zu Blume.",
          "img_index": -1
        },
        {
          "id": "s003",
          "text": "Dabei sammeln sie süßen Nektar für Honig und gelben Blütenstaub für ihre Babys.",
          "img_index": -1
        },
        {
          "id": "s004",
          "text": "Es gibt ganz viele verschiedene Bienenarten, nicht nur die Honigbiene.",
          "img_index": -1
        }
      ],
      "boxes": [],
      "table": null
    },
    {
      "id": "sec2",
      "heading": "So sehen Bienen aus",
      "section_role": "appearance_equipment",
      "sentences": [
        {
          "id": "s005",
          "text": "Die meisten Bienen sind klein, aber manche sind so lang wie dein Daumen.",
          "img_index": -1
        },
        {
          "id": "s006",
          "text": "Sie haben vier Flügel und oft gelbe oder orange Streifen.",
          "img_index": -1
        },
        {
          "id": "s007",
          "text": "Ihr Körper ist ein bisschen pelzig, damit der Blütenstaub gut hängen bleibt.",
          "img_index": -1
        },
        {
          "id": "s008",
          "text": "Mit ihrem langen Rüssel saugen sie den Nektar aus den Blüten.",
          "img_index": -1
        }
      ],
      "boxes": [
        {
          "type": "warnung",
          "text": "⚠️ Wusstest du, dass nur Bienen-Mamas stechen können? Denn der Stachel ist wie ein Werkzeug, das nur die weiblichen Bienen haben. Wenn eine Honigbiene sticht, bleibt ihr Stachel oft stecken. Dann stirbt sie leider. Viele Wildbienen stechen aber nur, wenn sie sich sehr bedroht fühlen, und ihr Stich tut nicht so weh."
        }
      ],
      "table": null
    },
    {
      "id": "sec3",
      "heading": "Was Bienen alles können",
      "section_role": "behavior_life",
      "sentences": [
        {
          "id": "s009",
          "text": "Bienen helfen den Pflanzen sehr.",
          "img_index": -1
        },
        {
          "id": "s010",
          "text": "Wenn sie von Blüte zu Blüte fliegen, tragen sie den Blütenstaub mit.",
          "img_index": -1
        },
        {
          "id": "s011",
          "text": "So können die Blumen Früchte und Samen machen.",
          "img_index": -1
        },
        {
          "id": "s012",
          "text": "Manche Bienen leben ganz allein, wie kleine Einzelkämpfer.",
          "img_index": -1
        },
        {
          "id": "s013",
          "text": "Andere leben in großen Familien zusammen, das nennt man ein Bienenvolk.",
          "img_index": -1
        },
        {
          "id": "s014",
          "text": "Dort gibt es dann viele Bienen, die zusammen Honig machen und sich um die Babys kümmern.",
          "img_index": -1
        }
      ],
      "boxes": [],
      "table": null
    }
