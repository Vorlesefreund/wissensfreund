  "sections": [
    {
      "id": "sec1",
      "heading": "Was ist eine Biene?",
      "section_role": "intro",
      "sentences": [
        {
          "id": "s001",
          "text": "Was ist das für ein kleines Tier, das so fleißig von Blume zu Blume fliegt?",
          "img_index": 0
        },
        {
          "id": "s002",
          "text": "Das ist die Biene!",
          "img_index": -1
        },
        {
          "id": "s003",
          "text": "Bienen sind kleine Insekten.",
          "img_index": 2
        },
        {
          "id": "s004",
          "text": "Sie haben sechs Beine und vier Flügel.",
          "img_index": -1
        },
        {
          "id": "s005",
          "text": "Sie besuchen viele bunte Blumen.",
          "img_index": 1
        },
        {
          "id": "s006",
          "text": "Dort sammeln sie etwas Süßes.",
          "img_index": 4
        }
      ],
      "boxes": [],
      "table": null
    },
    {
      "id": "sec2",
      "heading": "Bienen sind Blumen-Helfer",
      "section_role": "behavior_life",
      "sentences": [
        {
          "id": "s007",
          "text": "Wenn Bienen von Blume zu Blume fliegen, helfen sie den Blumen.",
          "img_index": -1
        },
        {
          "id": "s008",
          "text": "Sie tragen kleine Blütenstaub-Körner mit sich.",
          "img_index": -1
        },
        {
          "id": "s009",
          "text": "So können neue Blumen wachsen.",
          "img_index": -1
        },
        {
          "id": "s010",
          "text": "Das ist wie ein Zauber!",
          "img_index": -1
        },
        {
          "id": "s011",
          "text": "Bienen sind sehr wichtig für unsere Natur.",
          "img_index": -1
        }
      ],
      "boxes": [
        {
          "type": "wow",
          "text": "🌟 Wusstest du, dass Bienen ganz viele kleine Härchen haben? Daran bleiben die Blütenstaub-Körner wie in kleinen Taschen hängen!",
          "reveal_mode": "auto"
        }
      ],
      "table": null
    },
    {
      "id": "sec3",
      "heading": "Manche Bienen machen Honig",
      "section_role": "human_animal",
      "sentences": [
        {
          "id": "s012",
          "text": "Es gibt ganz viele verschiedene Bienenarten.",
          "img_index": 5
        },
        {
          "id": "s013",
          "text": "Die Honigbienen sind bekannt.",
          "img_index": -1
        },
        {
          "id": "s014",
          "text": "Sie leben in großen Familien.",
          "img_index": -1
        },
        {
          "id": "s015",
          "text": "Sie bauen Waben und machen leckeren Honig für uns.",
          "img_index": -1
        },
        {
          "id": "s016",
          "text": "Andere Bienen leben lieber allein.",
          "img_index": 6
        },
        {
          "id": "s017",
          "text": "Sie nennt man Wildbienen.",
          "img_index": -1
        },
        {
          "id": "s018",
          "text": "Sie machen keinen Honig für uns.",
          "img_index": -1
        }
      ],
      "boxes": [],
      "table": null
    },
    {
      "id": "sec4",
      "heading": "Der kleine Stachel",
      "section_role": "appearance_equipment",
      "sentences": [
        {
          "id": "s019",
          "text": "Manchmal haben Bienen auch einen kleinen Stachel.",
          "img_index": -1
        },
        {
          "id": "s020",
          "text": "Aber nur die weiblichen Bienen haben einen.",
          "img_index": -1
        },
        {
          "id": "s021",
          "text": "Wenn sie sich sehr erschrecken, können sie damit stechen.",
          "img_index": -1
        },
        {
          "id": "s022",
          "text": "Die meisten Wildbienen stechen aber nur ganz selten.",
          "img_index": -1
        },
        {
          "id": "s023",
          "text": "Und es tut dann nicht doll weh.",
          "img_index": -1
        }
      ],
      "boxes": [
        {
          "type": "warnung",
          "text": "⚠️ Nur die weiblichen Bienen haben einen Stachel. Männliche Bienen können nicht stechen.",
