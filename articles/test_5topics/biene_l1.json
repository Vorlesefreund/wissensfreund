  "sections": [
    {
      "id": "sec1",
      "heading": "Was ist eine Biene?",
      "section_role": "intro",
      "sentences": [
        {
          "id": "s001",
          "text": "Wenn du im Sommer draußen bist, hörst du oft ein leises Summen. Dann ist meistens eine Biene in der Nähe!",
          "img_index": -1
        },
        {
          "id": "s002",
          "text": "Bienen sind kleine Insekten, die fliegen können.",
          "img_index": 0
        },
        {
          "id": "s003",
          "text": "Sie haben sechs Beine und vier Flügel.",
          "img_index": -1
        },
        {
          "id": "s004",
          "text": "Viele Bienen leben zusammen in einem großen Zuhause und machen leckeren Honig.",
          "img_index": -1
        }
      ],
      "boxes": [],
      "table": null
    },
    {
      "id": "sec2",
      "heading": "Warum sind Bienen wichtig?",
      "section_role": "behavior_life",
      "sentences": [
        {
          "id": "s005",
          "text": "Bienen sind wie kleine Gärtner für unsere Blumen und Bäume.",
          "img_index": -1
        },
        {
          "id": "s006",
          "text": "Wenn sie von Blüte zu Blüte fliegen, sammeln sie Pollen.",
          "img_index": -1
        },
        {
          "id": "s007",
          "text": "Dabei helfen sie den Pflanzen, Früchte zu bilden und Samen zu machen.",
          "img_index": -1
        },
        {
          "id": "s008",
          "text": "Ohne Bienen gäbe es viel weniger Obst und Gemüse!",
          "img_index": -1
        }
      ],
      "boxes": [],
      "table": null
    },
    {
      "id": "sec3",
      "heading": "Der Stachel der Biene",
      "section_role": "human_animal",
      "sentences": [
        {
          "id": "s009",
          "text": "Manchmal hast du vielleicht Angst vor einem Bienenstich.",
          "img_index": -1
        },
        {
          "id": "s010",
          "text": "Aber nur die weiblichen Bienen haben einen Stachel und können stechen.",
          "img_index": -1
        },
        {
          "id": "s011",
          "text": "Männliche Bienen, die nennt man Drohnen, können das nicht.",
          "img_index": -1
        },
        {
          "id": "s012",
          "text": "Bienen stechen nur, wenn sie sich bedroht fühlen oder ihr Zuhause verteidigen wollen.",
          "img_index": -1
        }
      ],
      "boxes": [
        {
          "type": "wow",
          "text": "🌟 Wenn eine Honigbiene einen Menschen sticht, bleibt ihr Stachel stecken. Das ist traurig, denn die Biene stirbt danach."
        }
      ],
      "table": null
    },
    {
      "id": "sec4",
      "heading": "Viele verschiedene Bienen",
      "section_role": "curiosity",
      "sentences": [
        {
          "id": "s013",
          "text": "Es gibt nicht nur die eine Honigbiene, die Honig macht.",
          "img_index": -1
        },
        {
          "id": "s014",
          "text": "Auf der Welt gibt es über 20.000 verschiedene Bienenarten!",
          "img_index": -1
        },
        {
          "id": "s015",
          "text": "Viele davon sind Wildbienen und leben ganz alleine in kleinen Nestern.",
          "img_index": -1
        },
        {
          "id": "s016",
          "text": "Sie sind auch sehr wichtig für die Natur, auch wenn sie keinen Honig für uns machen.",
          "img_index": -1
        }
      ],
