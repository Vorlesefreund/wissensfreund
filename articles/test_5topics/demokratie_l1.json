  "sections": [
    {
      "id": "intro",
      "heading": "Was ist Demokratie?",
      "section_role": "intro",
      "sentences": [
        {
          "id": "s001",
          "text": "Stell dir vor, du spielst mit deinen Freunden und ihr müsst entscheiden, was ihr als Nächstes macht.",
          "img_index": -1
        },
        {
          "id": "s002",
          "text": "Wer darf das bestimmen?",
          "img_index": -1
        },
        {
          "id": "s003",
          "text": "In einer Demokratie dürfen alle mitreden und wählen, wer die Regeln macht.",
          "img_index": -1
        },
        {
          "id": "s004",
          "text": "Das ist wie ein großes Spiel, wo alle mitbestimmen, und der Ball nicht nur einem gehört.",
          "img_index": -1
        },
        {
          "id": "s005",
          "text": "Demokratie ist eine Art, wie Menschen in einem Land zusammenleben und wichtige Dinge entscheiden.",
          "img_index": -1
        }
      ],
      "boxes": []
    },
    {
      "id": "alle_stimmen_zaehlen",
      "heading": "Alle Stimmen zählen!",
      "section_role": "process_how",
      "sentences": [
        {
          "id": "s006",
          "text": "In einer Demokratie wählen die Menschen andere Menschen, die dann für sie sprechen.",
          "img_index": -1
        },
        {
          "id": "s007",
          "text": "Diese gewählten Leute überlegen dann, welche Regeln und Gesetze für alle gut sind.",
          "img_index": -1
        },
        {
          "id": "s008",
          "text": "Sie müssen aber immer daran denken, was die Leute wollen, die sie gewählt haben.",
          "img_index": -1
        },
        {
          "id": "s009",
          "text": "Das Wort Demokratie kommt übrigens aus einem alten Land namens Griechenland.",
          "img_index": -1
        },
        {
          "id": "s010",
          "text": "Dort haben sie schon vor langer Zeit gesagt, dass das Volk die Macht haben soll.",
          "img_index": -1
        }
      ],
      "boxes": [
        {
          "type": "wow",
          "text": "🌟 In einer Demokratie dürfen alle Erwachsenen bei wichtigen Entscheidungen mitmachen, indem sie wählen gehen. So kann niemand allein bestimmen!"
        }
      ],
      "table": null
    }
