  "sections": [
    {
      "id": "sec1",
      "heading": "Was ist Demokratie?",
      "section_role": "intro",
      "sentences": [
        {
          "id": "s001",
          "text": "Stell dir vor, ihr müsst in der Schule entscheiden, was ihr im nächsten Ausflug macht.",
          "img_index": -1
        },
        {
          "id": "s002",
          "text": "Wenn alle mitreden und abstimmen dürfen, dann ist das schon ein bisschen wie Demokratie!",
          "img_index": -1
        },
        {
          "id": "s003",
          "text": "Demokratie ist eine Art, wie ein Land regiert wird.",
          "img_index": -1
        },
        {
          "id": "s004",
          "text": "Das Wichtigste dabei ist: Das Volk, also alle erwachsenen Menschen im Land, hat die Macht und darf mitentscheiden.",
          "img_index": 0
        }
      ],
      "boxes": [
        {
          "type": "wow",
          "text": "🌟 Das Wort Demokratie kommt aus dem Altgriechischen und bedeutet wörtlich 'Volksherrschaft'. Das Volk (Demos) hat die Macht (Kratos)!"
        }
      ],
      "table": null
    },
    {
      "id": "sec2",
      "heading": "Wählen und Mitbestimmen",
      "section_role": null,
      "sentences": [
        {
          "id": "s005",
          "text": "In einer Demokratie wählen die Menschen Vertreter, die für sie im Parlament sitzen.",
          "img_index": 1
        },
        {
          "id": "s006",
          "text": "Diese Vertreter nennt man Abgeordnete und sie treffen die wichtigen Entscheidungen für das ganze Land.",
          "img_index": -1
        },
        {
          "id": "s007",
          "text": "Jeder Erwachsene darf bei Wahlen seine Stimme abgeben, und das ist immer frei und geheim.",
          "img_index": -1
        },
        {
          "id": "s008",
          "text": "So können alle mitbestimmen, wer regiert und welche Regeln gemacht werden.",
          "img_index": -1
        }
      ],
      "boxes": [],
      "table": null
    },
    {
      "id": "sec3",
      "heading": "Wichtige Regeln und Rechte",
      "section_role": null,
      "sentences": [
        {
          "id": "s009",
          "text": "Damit eine Demokratie gut funktioniert, gibt es wichtige Regeln.",
          "img_index": -1
        },
        {
          "id": "s010",
          "text": "Dazu gehören Grundrechte, die alle Menschen schützen.",
          "img_index": -1
        },
        {
          "id": "s011",
          "text": "Jeder darf zum Beispiel seine Meinung frei sagen und schreiben, und Zeitungen dürfen berichten, was sie wollen.",
          "img_index": -1
        },
        {
          "id": "s012",
          "text": "Auch Parteien, die nicht regieren, haben eine wichtige Aufgabe: Sie kontrollieren die Regierung und bieten andere Ideen an.",
          "img_index": -1
        },
        {
          "id": "s013",
          "text": "Man nennt sie Opposition.",
          "img_index": -1
        }
      ],
      "boxes": [
        {
          "type": "fakt",
          "text": "💡 Damit niemand zu viel Macht hat, wird sie geteilt: Eine Gruppe macht die Gesetze, eine andere regiert, und Richter passen auf, dass alles fair zugeht. Das nennt man Gewaltenteilung."
        }
      ],
      "table": null
    },
    {
      "id": "sec4",
      "heading": "Demokratie früher und heute",
      "section_role": null,
      "sentences": [
        {
          "id": "s014",
          "text": "Die Idee der Demokratie ist schon sehr alt.",
          "img_index": -1
        },
        {
          "id": "s015",
          "text": "Vor über 2000 Jahren gab es im alten Griechenland, in der Stadt Athen, eine frühe Form der Demokratie.",
          "img_index": 2
        },
        {
          "id": "s016",
          "text": "Dort durften aber nur freie Männer mitmachen und abstimmen, keine Frauen oder Sklaven.",
          "img_index": -1
        },
        {
          "id": "s017",
          "text": "Heute ist das anders: In modernen Demokratien dürfen alle erwachsenen Menschen, Männer und Frauen, wählen und mitentscheiden.",
          "img_index": -1
        }
      ],
      "boxes": [],
      "table": null
    }
