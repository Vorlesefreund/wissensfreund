  "sections": [
    {
      "id": "sec1",
      "heading": "Was ist ein Motor?",
      "section_role": "intro",
      "sentences": [
        {
          "id": "s001",
          "text": "Stell dir vor, du hast ein Spielzeugauto, das von alleine fährt.",
          "img_index": -1
        },
        {
          "id": "s002",
          "text": "Oder ein großes Schiff, das über das Meer gleitet.",
          "img_index": -1
        },
        {
          "id": "s003",
          "text": "Dahinter steckt immer ein Motor!",
          "img_index": -1
        },
        {
          "id": "s004",
          "text": "Ein Motor ist eine besondere Maschine.",
          "img_index": -1
        },
        {
          "id": "s005",
          "text": "Er kann Dinge bewegen.",
          "img_index": -1
        },
        {
          "id": "s006",
          "text": "Dafür braucht er Energie, zum Beispiel von Benzin oder Strom.",
          "img_index": -1
        },
        {
          "id": "s007",
          "text": "Diese Energie macht der Motor zu Bewegung.",
          "img_index": 0
        }
      ],
      "boxes": [],
      "table": null
    },
    {
      "id": "sec2",
      "heading": "Wie ein Motor arbeitet",
      "section_role": "process_how",
      "sentences": [
        {
          "id": "s008",
          "text": "Viele Motoren haben ein Teil, das sich dreht.",
          "img_index": -1
        },
        {
          "id": "s009",
          "text": "Das ist wie eine Stange, die sich ganz schnell im Kreis bewegt.",
          "img_index": -1
        },
        {
          "id": "s010",
          "text": "Diese Drehung kann dann Räder antreiben oder etwas anderes in Gang setzen.",
          "img_index": -1
        },
        {
          "id": "s011",
          "text": "Es gibt auch Motoren, die anders arbeiten, zum Beispiel bei einer Rakete.",
          "img_index": -1
        }
      ],
      "boxes": [
        {
          "type": "wow",
          "text": "🌟 Motoren sind überall! Sie stecken in deinen Spielzeugen, in Mamas oder Papas Auto, in großen Lastwagen, in Flugzeugen und in Schiffen! Was für ein Kraftpaket!"
        }
      ],
      "table": null
    },
    {
      "id": "sec3",
      "heading": "Motoren früher und heute",
      "section_role": "historical_context",
      "sentences": [
        {
          "id": "s012",
          "text": "Ganz früher gab es Dampfmaschinen.",
          "img_index": -1
        },
        {
          "id": "s013",
          "text": "Die haben mit heißem Dampf gearbeitet und waren riesig!",
          "img_index": -1
        },
        {
          "id": "s014",
          "text": "Heute gibt es viele verschiedene Motoren.",
          "img_index": -1
        },
        {
          "id": "s015",
          "text": "Die wichtigsten sind Elektromotoren und Motoren, die Benzin verbrennen.",
          "img_index": -1
        },
        {
          "id": "s016",
          "text": "Elektromotoren findest du zum Beispiel in deinem Spielzeug oder in manchen Fahrrädern.",
          "img_index": -1
        },
        {
          "id": "s017",
          "text": "Motoren, die Benzin verbrennen, sind oft in Autos oder Motorrollern.",
          "img_index": -1
        }
      ],
      "boxes": [],
      "table": null
    }
