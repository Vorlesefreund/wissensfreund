    {
      "id": "sec2",
      "heading": "Was ein Motor macht",
      "section_role": "process_how",
      "sentences": [
        {
          "id": "s006",
          "text": "Ein Motor verwandelt Energie in Bewegung.",
          "img_index": -1
        },
        {
          "id": "s007",
          "text": "Stell dir vor, du drückst einen Knopf.",
          "img_index": -1
        },
        {
          "id": "s008",
          "text": "Dann bekommt der Motor Strom.",
          "img_index": -1
        },
        {
          "id": "s009",
          "text": "Oder er verbrennt Benzin, wie im großen Auto.",
          "img_index": -1
        },
        {
          "id": "s010",
          "text": "Aus dieser Energie macht der Motor Kraft.",
          "img_index": -1
        },
        {
          "id": "s011",
          "text": "Diese Kraft lässt dann zum Beispiel Räder drehen.",
          "img_index": -1
        }
      ],
      "boxes": [],
      "table": null
    },
    {
      "id": "sec3",
      "heading": "Viele Arten von Motoren",
      "section_role": "today_legacy",
      "sentences": [
        {
          "id": "s012",
          "text": "Es gibt ganz viele Motoren.",
          "img_index": -1
        },
        {
          "id": "s013",
          "text": "Elektromotoren brauchen Strom.",
          "img_index": -1
        },
        {
          "id": "s014",
          "text": "Die findest du in Spielsachen oder in Elektroautos.",
          "img_index": -1
        },
        {
          "id": "s015",
          "text": "Verbrennungsmotoren nutzen Benzin oder Diesel.",
          "img_index": -1
        },
        {
          "id": "s016",
          "text": "Sie sind in fast allen Autos und Lastwagen.",
          "img_index": -1
        },
        {
          "id": "s017",
          "text": "Auch alte Züge fuhren mit Dampfmotoren.",
          "img_index": -1
        },
        {
          "id": "s018",
          "text": "Motoren sind überall, wo sich etwas bewegen soll!",
          "img_index": -1
        }
      ],
      "boxes": [
        {
          "type": "wow",
          "text": "🌟 Schon vor über 2000 Jahren gab es Motoren! Sie haben Dampf genutzt, um große Türen zu öffnen. Stell dir das mal vor!"
