      "heading": "Was ist ein Motor?",
      "section_role": "intro",
      "sentences": [
        {
          "id": "s001",
          "text": "Was bringt dein Spielzeugauto zum Rollen?",
          "img_index": -1
        },
        {
          "id": "s002",
          "text": "Oder den Zug zum Fahren?",
          "img_index": -1
        },
        {
          "id": "s003",
          "text": "Das ist ein Motor!",
          "img_index": -1
        },
        {
          "id": "s004",
          "text": "Ein Motor ist eine besondere Maschine.",
          "img_index": -1
        },
        {
          "id": "s005",
          "text": "Er kann Dinge bewegen.",
          "img_index": -1
