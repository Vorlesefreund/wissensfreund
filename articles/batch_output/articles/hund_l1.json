  "sections": [
    {
      "id": "sec1",
      "heading": "Wer ist der Hund?",
      "section_role": "intro",
      "sentences": [
        {
          "id": "s001",
          "text": "Ein wildes Wedeln an der Tür begrüßt dich.",
          "img_index": 0
        },
        {
          "id": "s002",
          "text": "Der Haushund ist der beste Freund des Menschen.",
          "img_index": -1
        },
        {
          "id": "s003",
          "text": "Er lebt als Haustier ganz nah bei uns.",
          "img_index": -1
        },
        {
          "id": "s004",
          "text": "Sein wilder Ur-Opa ist der Wolf.",
          "img_index": 1
        },
        {
          "id": "s005",
          "text": "Hunde stammen nämlich direkt von Wölfen ab.",
          "img_index": -1
        },
        {
          "id": "s006",
          "text": "Deshalb sind sie sehr eng miteinander verwandt.",
          "img_index": -1
        }
      ],
      "boxes": [],
      "table": null
    },
    {
      "id": "sec2",
      "heading": "Die Super-Sinne der Hunde",
      "section_role": "appearance_equipment",
      "sentences": [
        {
          "id": "s007",
          "text": "Hunde können manche Dinge viel besser als wir.",
          "img_index": -1
        },
        {
          "id": "s008",
          "text": "Ihre beweglichen Ohren hören extrem leise Geräusche.",
          "img_index": 2
        },
        {
          "id": "s009",
          "text": "Sie drehen die Ohren in alle Richtungen.",
          "img_index": -1
        },
        {
          "id": "s010",
          "text": "Auch die feine Hundenase ist ein echtes Wunder.",
          "img_index": -1
        },
        {
          "id": "s011",
          "text": "Ein Hund riecht viel besser als ein Mensch.",
          "img_index": 3
        },
        {
          "id": "s012",
          "text": "Er riecht sogar den Angstschweiß von Menschen.",
          "img_index": -1
        },
        {
          "id": "s013",
          "text": "Außerdem spüren Hunde das Magnetfeld unserer Erde.",
          "img_index": -1
        }
      ],
      "boxes": [
        {
          "type": "wow",
          "text": "Hunde können mit ihrer feinen Nase sogar rechts und links unterscheiden. Sie riechen also in 3D!"
        }
      ],
      "table": null
    },
    {
      "id": "sec3",
      "heading": "Kuschelige Hundebabys",
      "section_role": "reproduction",
      "sentences": [
        {
          "id": "s014",
          "text": "Junge Hunde heißen Welpen.",
          "img_index": 4
        },
        {
          "id": "s015",
          "text": "Sie kommen blind und ohne Zähne zur Welt.",
          "img_index": -1
        },
        {
          "id": "s016",
          "text": "Die ersten Milchzähne wachsen nach drei Wochen.",
          "img_index": -1
        },
        {
          "id": "s017",
          "text": "Am Anfang trinken die Babys nur Muttermilch.",
          "img_index": -1
        },
        {
          "id": "s018",
          "text": "Sie kuscheln sich ganz eng an ihre Mutter.",
          "img_index": 5
        },
        {
          "id": "s019",
          "text": "Das sanfte Streicheln beruhigt die kleinen Welpen sehr.",
          "img_index": -1
        },
        {
          "id": "s020",
          "text": "Ihr Herz schlägt dann viel langsamer und ruhiger.",
          "img_index": -1
        }
      ],
      "boxes": [],
      "table": null
    },
    {
      "id": "sec4",
      "heading": "Große Helfer und Freunde",
      "section_role": "human_animal",
      "sentences": [
        {
          "id": "s021",
          "text": "Es gibt riesige Doggen und winzige Chihuahuas.",
          "img_index": 6
        },
        {
          "id": "s022",
          "text": "Diese verschiedenen Sorten nennen wir Hunderassen.",
          "img_index": -1
        },
        {
          "id": "s023",
          "text": "In Australien leben sogar wilde Hunde, die Dingos.",
          "img_index": 7
        },
        {
          "id": "s024",
          "text": "Viele Hunde haben richtige Berufe bei uns Menschen.",
          "img_index": -1
        },
        {
          "id": "s025",
          "text": "Sie retten zum Beispiel Menschen aus tiefem Schnee.",
          "img_index": 8
        },
        {
          "id": "s026",
          "text": "Doch vor allem schenken Hunde uns viel Freude.",
          "img_index": -1
        },
        {
          "id": "s027",
          "text": "Sie begleiten uns treu an jedem einzelnen Tag.",
          "img_index": -1
        }
      ],
      "boxes": [
        {
          "type": "warnung",
          "text": "Schokolade ist für Hunde sehr giftig. Sie dürfen davon niemals naschen!"
        }
      ],
      "table": null
    }
  ],
