  "source_passages": [
    {
      "claim": "Der Haushund ist der beste Freund des Menschen. Er lebt als Haustier ganz nah bei uns.",
      "source": "Haushund",
      "passage": "Der Haushund (Canis lupus familiaris) ist ein Haustier und wird als Heim- und Nutztier gehalten."
    },
    {
      "claim": "Sein wilder Ur-Opa ist der Wolf.",
      "source": "Haushund",
      "passage": "Seine wilde Stammform ist der Wolf, dem er als Unterart zugeordnet wird."
    },
    {
      "claim": "Ihre beweglichen Ohren hören extrem leise Geräusche.",
      "source": "Haushund",
      "passage": "Das Ohr des Hundes ist hoch entwickelt; es kann höhere Frequenzen wahrnehmen als das des Menschen..."
    },
    {
      "claim": "Ein Hund riecht viel besser als ein Mensch. Er riecht sogar den Angstschweiß von Menschen.",
      "source": "Haushund",
      "passage": "Hunde können auch Angstschweiß von Menschen riechen."
    },
    {
      "claim": "Hunde riechen eine Million Mal besser als Menschen.",
      "source": "Haushund",
      "passage": "Messungen haben ein im Vergleich zum Menschen etwa eine Million Mal besseres Riechvermögen ergeben."
    },
    {
      "claim": "Außerdem spüren Hunde das Magnetfeld unserer Erde.",
      "source": "Haushund",
      "passage": "Haushunde verfügen über die Fähigkeit, das Magnetfeld der Erde wahrzunehmen."
    },
    {
      "claim": "Junge Hunde heißen Welpen.",
      "source": "Welpe",
      "passage": "Als Welpe bezeichnet man einen juvenilen Haushund..."
    },
    {
      "claim": "Sie kommen blind und ohne Zähne zur Welt.",
      "source": "Haushund",
      "passage": "Hunde werden zahnlos geboren."
    },
    {
      "claim": "Das sanfte Streicheln beruhigt die kleinen Welpen sehr. Ihr Herz schlägt dann viel langsamer und ruhiger.",
      "source": "Haushund",
      "passage": "Durch Berührungen können Hunde messbar beruhigt werden – der Puls wird langsamer und die Atmung regelmäßiger."
    },
    {
      "claim": "In Australien leben sogar wilde Hunde, die Dingos.",
      "source": "Dingo",
      "passage": "Der Dingo (Canis lupus dingo) ist ein Haushund, der vor mehreren tausend Jahren verwilderte und heute in vielen Teilen seines Verbreitungsgebietes in Südostasien und vor allem Australien vom Menschen völlig unabhängig lebt."
    },
    {
      "claim": "Sie retten zum Beispiel Menschen aus tiefem Schnee.",
      "source": "Rettungshund",
      "passage": "Nach dem Abgang von Lawinen verschüttete Personen können durch Lawinensuchhundeteams unter dem Schnee gesucht werden."
    },
    {
      "claim": "Schokolade ist für Hunde sehr giftig.",
      "source": "Haushund",
      "passage": "Viele menschliche Nahrungs- und Genussmittel sind für Hunde mehr oder weniger giftig, so zum Beispiel Schokolade..."
    }
  ]
