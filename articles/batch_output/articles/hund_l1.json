  "sections": [
    {
      "id": "intro",
      "heading": "Der beste Freund des Menschen",
      "section_role": "intro",
      "sentences": [
        {
          "id": "s001",
          "text": "Viele Kinder wünschen sich einen treuen Spielkameraden.",
          "img_index": 0
        },
        {
          "id": "s002",
          "text": "Der Hund ist der beste Freund des Menschen.",
          "img_index": -1
        },
        {
          "id": "s003",
          "text": "Er ist ein sehr beliebtes Haustier.",
          "img_index": -1
        },
        {
          "id": "s004",
          "text": "Hunde gehören zur großen Familie der Wölfe.",
          "img_index": 2
        },
        {
          "id": "s005",
          "text": "Wölfe sind die wilden Vorfahren unserer Hunde.",
          "img_index": -1
        },
        {
          "id": "s006",
          "text": "Hunde und Wölfe können sogar gemeinsame Babys bekommen.",
          "img_index": -1
        }
      ],
      "boxes": [],
      "table": null
    },
    {
      "id": "appearance_equipment",
      "heading": "Wie sieht ein Hund aus?",
      "section_role": "appearance_equipment",
      "sentences": [
        {
          "id": "s007",
          "text": "Es gibt winzige Hunde und riesige Hunde.",
          "img_index": 3
        },
        {
          "id": "s008",
          "text": "Manche Hunde haben Schlappohren, andere haben Stehohren.",
          "img_index": -1
        },
        {
          "id": "s009",
          "text": "Ihre Schwänze können gerade oder lustig eingerollt sein.",
          "img_index": -1
        },
        {
          "id": "s010",
          "text": "Hunde haben sehr feine Sinne.",
          "img_index": -1
        },
        {
          "id": "s011",
          "text": "Sie riechen viel besser als wir Menschen.",
          "img_index": 4
        },
        {
          "id": "s012",
          "text": "Ihre Nase ist immer kühl und feucht.",
          "img_index": -1
        },
        {
          "id": "s013",
          "text": "Sie spüren damit sogar weit entfernte Wärme.",
          "img_index": -1
        },
        {
          "id": "s014",
          "text": "Mit ihren Fühlhaaren im Gesicht weichen sie Hindernissen aus.",
          "img_index": 5
        },
        {
          "id": "s015",
          "text": "Hunde hören auch ganz leise Geräusche sehr gut.",
          "img_index": 6
        }
      ],
      "boxes": [
        {
          "type": "wow",
          "text": "🌟 Hunde können mit ihrer kalten Nase die Wärme von anderen Tieren spüren! Das kann sonst fast kein anderes Säugetier auf der Welt."
        }
      ],
      "table": null
    },
    {
      "id": "behavior_life",
      "heading": "Das Leben der Hunde",
      "section_role": "behavior_life",
      "sentences": [
        {
          "id": "s016",
          "text": "Hundebabys heißen Welpen.",
          "img_index": 1
        },
        {
          "id": "s017",
          "text": "Nach der Geburt trinken sie Milch bei ihrer Mama.",
          "img_index": 7
        },
        {
          "id": "s018",
          "text": "Ihre Augen öffnen sich erst nach zwei Wochen.",
          "img_index": -1
        },
        {
          "id": "s019",
          "text": "Hunde sprechen mit ihrem ganzen Körper.",
          "img_index": -1
        },
        {
          "id": "s020",
          "text": "Wenn sie sich freuen, wedeln sie mit dem Schwanz.",
          "img_index": -1
        },
        {
          "id": "s021",
          "text": "Hunde bellen, um uns zu warnen.",
          "img_index": -1
        },
        {
          "id": "s022",
          "text": "Manche Hunde heulen auch wie Wölfe.",
          "img_index": -1
        },
        {
          "id": "s023",
          "text": "So rufen sie ihre Freunde herbei.",
          "img_index": -1
        },
        {
          "id": "s024",
          "text": "Hunde lieben es, im Gras zu tollen.",
          "img_index": -1
        },
        {
          "id": "s025",
          "text": "Sie spielen gerne mit weichen Bällen und Spielzeug.",
          "img_index": -1
        }
      ],
      "boxes": [],
      "table": null
    },
    {
      "id": "human_animal",
      "heading": "Hunde helfen den Menschen",
      "section_role": "human_animal",
      "sentences": [
        {
          "id": "s026",
          "text": "Hunde arbeiten oft richtig mit uns zusammen.",
          "img_index": -1
        },
        {
          "id": "s027",
          "text": "Es gibt schlaue Rettungshunde bei der Feuerwehr.",
          "img_index": 8
        },
        {
          "id": "s028",
          "text": "Sie suchen vermisste Menschen im dichten Wald.",
          "img_index": -1
        },
        {
          "id": "s029",
          "text": "Andere Hunde führen blinde Menschen sicher durch die Stadt.",
          "img_index": -1
        },
        {
          "id": "s030",
          "text": "Am liebsten kuscheln Hunde mit ihrer Familie.",
          "img_index": -1
        },
        {
          "id": "s031",
          "text": "Wir müssen gut für unsere Hunde sorgen.",
          "img_index": -1
        },
        {
          "id": "s032",
          "text": "Sie brauchen gesundes Futter und frisches Wasser.",
          "img_index": -1
        },
        {
          "id": "s033",
          "text": "Dann bleiben sie fit und glücklich.",
          "img_index": -1
        }
      ],
      "boxes": [],
      "table": null
    }
  ],
