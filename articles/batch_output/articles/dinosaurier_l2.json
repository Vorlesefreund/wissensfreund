  "source_passages": [
    {
      "claim": "Vögel gingen aus kleinen Dinosauriern hervor.",
      "source": "Dinosaurier",
      "passage": "Vögel gingen aus kleinen theropoden Dinosauriern hervor."
    },
    {
      "claim": "Der Name Dinosaurier bedeutet schreckliche Echse.",
      "source": "Dinosaurier",
      "passage": "Die Dinosaurier (Dinosauria, von altgriechisch δεινός deinós, deutsch ‚schrecklich, gewaltig‘ und altgriechisch σαῦρος sauros, deutsch ‚Eidechse‘)"
    },
    {
      "claim": "Sie beherrschten die Erde im Erdmittelalter.",
      "source": "Dinosaurier",
      "passage": "...die im Erdmittelalter von der Oberen Trias vor rund 235 Millionen Jahren bis zur Kreide-Paläogen-Grenze vor etwa 66 Millionen Jahren die festländischen Ökosysteme dominierte."
    },
    {
      "claim": "Ihre Beine standen gerade unter dem Körper.",
      "source": "Dinosaurier",
      "passage": "Bei den Dinosauriern standen die Beine senkrecht unter dem Körper, ähnlich wie bei den meisten Säugetieren..."
    },
    {
      "claim": "Maiasaura-Dinosaurier kümmerten sich um ihre Jungen nach dem Schlüpfen.",
      "source": "Dinosaurier",
      "passage": "Eine Maiasaura-Nestkolonie, die Jack Horner im Jahr 1978 in Montana (USA) entdeckt hat, zeigt, dass einige Dinosaurier ihre Jungen noch lange nach dem Schlüpfen betreuten und beschützten."
    },
    {
      "claim": "Der größte Zahn eines Fleischfressers war 30 Zentimeter lang.",
      "source": "Tyrannosaurus",
      "passage": "Der größte gefundene Zahn wird inklusive Zahnwurzel auf 30 cm Länge geschätzt; damit ist er der größte Zahn, der bisher von einem fleischfressenden Dinosaurier bekannt ist."
    },
    {
      "claim": "Flugsaurier lebten zeitgleich, waren aber keine Dinosaurier.",
      "source": "Flugsaurier",
      "passage": "Die Flugsaurier (Pterosauria) sind ausgestorbene Reptilien, die etwa gleichzeitig mit den Nichtvogeldinosauriern lebten..."
    },
    {
      "claim": "Pflanzenfresser schluckten Steine zur Zerkleinerung der Nahrung.",
      "source": "Dinosaurier",
      "passage": "...Gastrolithen (Magensteinen, die zur Zerkleinerung der Nahrung von einigen Dinosauriern verschluckt wurden)..."
    }
  ]
