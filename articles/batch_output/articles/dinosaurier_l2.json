  "sections": [
    {
      "id": "sec1",
      "heading": "Wer waren die Riesenechsen?",
      "section_role": "intro",
      "sentences": [
        {
          "id": "s001",
          "text": "Hast du heute schon einen echten Dinosaurier gesehen?",
          "img_index": 6
        },
        {
          "id": "s002",
          "text": "Das ist gut möglich, denn Vögel sind eng mit ihnen verwandt.",
          "img_index": -1
        },
        {
          "id": "s003",
          "text": "Dinosaurier waren besondere Landwirbeltiere, die vor Millionen von Jahren im sogenannten Erdmittelalter die Erde beherrschten.",
          "img_index": 5
        },
        {
          "id": "s004",
          "text": "Ihr Name bedeutet übersetzt „schreckliche Echse“.",
          "img_index": -1
        },
        {
          "id": "s005",
          "text": "Damals lebten sie auf allen Kontinenten der Erde.",
          "img_index": -1
        },
        {
          "id": "s006",
          "text": "Heute finden Forscher überall ihre versteinerten Reste.",
          "img_index": 9
        }
      ],
      "boxes": [],
      "table": null
    },
    {
      "id": "sec2",
      "heading": "Riesen mit Federn und Hörnern",
      "section_role": "appearance_equipment",
      "sentences": [
        {
          "id": "s007",
          "text": "Die Urzeit-Tiere sahen sehr unterschiedlich aus.",
          "img_index": -1
        },
        {
          "id": "s008",
          "text": "Es gab riesige Pflanzenfresser mit langen Hälsen wie den Brachiosaurus.",
          "img_index": 0
        },
        {
          "id": "s009",
          "text": "Andere waren fleischfressende Riesen auf zwei Beinen wie der Tyrannosaurus Rex.",
          "img_index": 1
        },
        {
          "id": "s010",
          "text": "Der Triceratops wiederum besaß drei große Hörner im Gesicht und einen schützenden Nackenschild.",
          "img_index": 2
        },
        {
          "id": "s011",
          "text": "Aber nicht alle waren riesig.",
          "img_index": -1
        },
        {
          "id": "s012",
          "text": "Einige hatten nur die Größe von Hühnern.",
          "img_index": 5
        },
        {
          "id": "s013",
          "text": "Ein wichtiger Unterschied zu heutigen Reptilien war ihre Haltung.",
          "img_index": -1
        },
        {
          "id": "s014",
          "text": "Ihre Beine standen gerade unter dem Körper.",
          "img_index": -1
        },
        {
          "id": "s015",
          "text": "Dadurch konnten sie leichter laufen, besser atmen und wurden sehr ausdauernd.",
          "img_index": -1
        },
        {
          "id": "s016",
          "text": "Manche hatten sogar Federn.",
          "img_index": -1
        }
      ],
      "boxes": [
        {
          "type": "wow",
          "text": "🌟 Der größte Zahn eines Fleischfressers war inklusive der Wurzel unglaubliche 30 Zentimeter lang. Er gehörte dem Tyrannosaurus Rex!"
        }
      ],
      "table": null
    },
    {
      "id": "sec3",
      "heading": "Gemeinsam stark in der Herde",
      "section_role": "behavior_life",
      "sentences": [
        {
          "id": "s017",
          "text": "Dinosaurier lebten nicht immer allein.",
          "img_index": -1
        },
        {
          "id": "s018",
          "text": "Durch versteinerte Fußspuren wissen wir, dass viele Arten in Herden wanderten.",
          "img_index": -1
        },
        {
          "id": "s019",
          "text": "Das bot Schutz vor hungrigen Feinden.",
          "img_index": -1
        },
        {
          "id": "s020",
          "text": "Pflanzenfresser schluckten manchmal Steine herunter.",
          "img_index": -1
        },
        {
          "id": "s021",
          "text": "Diese Magensteine halfen, die Nahrung im Bauch zu zerkleinern.",
          "img_index": -1
        },
        {
          "id": "s022",
          "text": "Einige Dinosaurier bauten auch riesige Nester.",
          "img_index": 4
        },
        {
          "id": "s023",
          "text": "Die Maiasaura-Dinosaurier kümmerten sich liebevoll um ihre Babys nach dem Schlüpfen.",
          "img_index": 3
        },
        {
          "id": "s024",
          "text": "Sie brachten ihnen Futter und bewachten das Nest.",
          "img_index": -1
        },
        {
          "id": "s025",
          "text": "Andere brüteten ihre Eier mit ihrem eigenen Körper warm, genau wie Vögel heute.",
          "img_index": -1
        }
      ],
      "boxes": [],
      "table": null
    },
    {
      "id": "sec4",
      "heading": "Wie wir die Urzeit-Riesen entdecken",
      "section_role": "human_animal",
      "sentences": [
        {
          "id": "s026",
          "text": "Seit dem Ende der Kreidezeit vor 66 Millionen Jahren sind die Urzeit-Echsen ausgestorben.",
          "img_index": -1
        },
        {
          "id": "s027",
          "text": "Wahrscheinlich stürzte damals ein riesiger Meteorit auf die Erde.",
          "img_index": -1
        },
        {
          "id": "s028",
          "text": "Dieser Gesteinsbrocken aus dem All brachte eine lange Kälte.",
          "img_index": -1
        },
        {
          "id": "s029",
          "text": "Heute erforschen Paläontologen – das sind Wissenschaftler für Urzeit-Lebewesen – ihre Knochen und Spuren.",
          "img_index": 7
        },
        {
          "id": "s030",
          "text": "Diese Funde nennen wir Fossilien.",
          "img_index": -1
        },
        {
          "id": "s031",
          "text": "In Museen auf der ganzen Welt bestaunen Kinder und Erwachsene die riesigen Skelette.",
          "img_index": 8
        },
        {
          "id": "s032",
          "text": "Früher stritten sich Forscher sogar wild darum, wer die meisten Knochen fand.",
          "img_index": -1
        }
      ],
      "boxes": [
        {
          "type": "stimmt_das",
          "text": "🤔 Waren alle urzeitlichen Riesenechsen Dinosaurier?",
          "reveal_text": "Nein! Flugsaurier waren eine eigene Gruppe von fliegenden Reptilien, die zeitgleich mit den Dinosauriern lebten, aber nicht zu ihnen gehörten.",
          "reveal_mode": "auto"
        }
      ],
      "table": null
    }
  ],
