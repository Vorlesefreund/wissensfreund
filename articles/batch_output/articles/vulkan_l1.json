  "source_passages": [
    {
      "claim": "Ein Vulkan ist ein ganz besonderer Berg. Tief unter der Erde ist es extrem heiß. Dort schmilzt sogar hartes Gestein.",
      "source": "Vulkan",
      "passage": "Im Fall der Erde schmelzen Gesteine ab 100 km Tiefe bei Temperaturen zwischen 1000 und 1300 °C. Das flüssige Magma sammelt sich in großen Magmaherden in 2 bis 50 km Tiefe."
    },
    {
      "claim": "Diese flüssige Suppe heißt Magma.",
      "source": "Magma",
      "passage": "Als Magma (sächlich; von altgriechisch μάγμα mágma, deutsch ‚geknetete Masse‘) wird im Untergrund befindliche Gesteinsschmelze bezeichnet."
    },
    {
      "claim": "An der Luft nennen wir die Suppe Lava.",
      "source": "Vulkan",
      "passage": "Magma, das an die Erdoberfläche gelangt, wird als Lava bezeichnet."
    },
    {
      "claim": "Sogar im Weltall gibt es Vulkane. Auf dem Planeten Mars schlafen sie schon.",
      "source": "Vulkan",
      "passage": "Auf vielen Welten des Sonnensystems finden sich Spuren erloschenen Vulkanismus, wie beispielsweise auf dem Erdmond oder dem Mars."
    },
    {
      "claim": "In der Eifel gibt es alte Krater.",
      "source": "Vulkan",
      "passage": "Beispiele für diese seltene Art des Vulkanismus in Europa finden sich in der Ost- und Westeifel (Vulkaneifel)..."
    },
    {
      "claim": "Tief im Boden ist es heiß. Dort erwärmt ein Vulkan das Grundwasser. Plötzlich schießt eine heiße Wasser-Säule hoch! Das nennen Forscher einen Geysir.",
      "source": "Geysir",
      "passage": "Ein Geysir, auch Geiser genannt, ist eine heiße Quelle, die ihr Wasser in regelmäßigen oder unregelmäßigen Abständen als Fontäne ausstößt."
    }
  ]
