  "sections": [
    {
      "id": "sec1",
      "heading": "Die Riesen der Urzeit",
      "section_role": "intro",
      "sentences": [
        {
          "id": "s001",
          "text": "Stell dir ein Tier vor, so riesig wie ein Haus.",
          "img_index": 0
        },
        {
          "id": "s002",
          "text": "Das sind Dinosaurier, die vor sehr langer Zeit lebten.",
          "img_index": -1
        },
        {
          "id": "s003",
          "text": "Sie herrschten damals überall auf unserem Planeten Erde.",
          "img_index": -1
        },
        {
          "id": "s004",
          "text": "Heute gibt es diese riesigen Ur-Tiere nicht mehr.",
          "img_index": 5
        }
      ],
      "boxes": [],
      "table": null
    },
    {
      "id": "sec2",
      "heading": "Wie sie aussahen",
      "section_role": "appearance_equipment",
      "sentences": [
        {
          "id": "s005",
          "text": "Manche Dinosaurier waren so groß wie ein ganzes Haus.",
          "img_index": 0
        },
        {
          "id": "s006",
          "text": "Ihr langer Hals reichte bis hoch in die Baumkronen.",
          "img_index": -1
        },
        {
          "id": "s007",
          "text": "Andere waren winzig klein, so wie ein kleines Huhn.",
          "img_index": 7
        },
        {
          "id": "s008",
          "text": "Einige trugen dicke Panzer oder spitze Hörner im Gesicht.",
          "img_index": -1
        },
        {
          "id": "s009",
          "text": "Der berühmte Triceratops hatte drei große Hörner am Kopf.",
          "img_index": 1
        },
        {
          "id": "s010",
          "text": "Viele Arten liefen ganz aufrecht auf zwei starken Beinen.",
          "img_index": 5
        }
      ],
      "boxes": [],
      "table": null
    },
    {
      "id": "sec3",
      "heading": "Wie die Dinos lebten",
      "section_role": "behavior_life",
      "sentences": [
        {
          "id": "s011",
          "text": "Viele Dinosaurier fraßen gemütlich Blätter von den Bäumen.",
          "img_index": -1
        },
        {
          "id": "s012",
          "text": "Sie wanderten oft zusammen in einer großen, sicheren Gruppe.",
          "img_index": 2
        },
        {
          "id": "s013",
          "text": "Andere Dinos jagten lieber Fleisch und hatten scharfe Zähne.",
          "img_index": 6
        },
        {
          "id": "s014",
          "text": "Die Mamas bauten Nester und legten dort runde Eier hinein.",
          "img_index": 4
        },
        {
          "id": "s015",
          "text": "Sie beschützten ihre kleinen Dino-Babys nach dem Schlüpfen gut.",
          "img_index": 2
        }
      ],
      "boxes": [],
      "table": null
    },
    {
      "id": "sec4",
      "heading": "Dinosaurier ganz nah",
      "section_role": "human_animal",
      "sentences": [
        {
          "id": "s016",
          "text": "Heute finden wir versteinerte Knochen im tiefen Erdboden.",
          "img_index": 3
        },
        {
          "id": "s017",
          "text": "Fachleute graben sie vorsichtig aus und säubern sie genau.",
          "img_index": 9
        },
        {
          "id": "s018",
          "text": "Im Museum kannst du diese echten Riesenskelette selbst bestaunen.",
          "img_index": 0
        },
        {
          "id": "s019",
          "text": "Bestimmt kennst du auch das D auf deiner Anlauttabelle.",
          "img_index": 8
        },
        {
          "id": "s020",
          "text": "Dort zeigt das Bild meistens einen grünen Dino.",
          "img_index": -1
        },
        {
          "id": "s021",
          "text": "Wusstest du schon, dass Vögel mit den Dinos verwandt sind?",
          "img_index": 6
        },
        {
          "id": "s022",
          "text": "Spatzen und Pinguine sind also kleine, lebendige Dinos.",
          "img_index": -1
        }
      ],
      "boxes": [
        {
          "type": "wow",
          "text": "🌟 Forscher fanden sogar im eisigen Südpol versteinere Dino-Knochen."
        }
      ],
      "table": null
    }
  ],
