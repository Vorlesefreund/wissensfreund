  "source_passages": [
    {
      "claim": "Das sind Dinosaurier, die vor sehr langer Zeit lebten.",
      "source": "Dinosaurier",
      "passage": "Die Dinosaurier (Dinosauria... ) sind eine Gruppe der Landwirbeltiere, die im Erdmittelalter... die festländischen Ökosysteme dominierte."
    },
    {
      "claim": "Andere waren winzig klein, so wie ein kleines Huhn.",
      "source": "Dinosaurier",
      "passage": "Die kleinsten Dinosaurier hatten die Größe eines Huhns, so waren die Theropoden Microraptor und Parvicursor beide weniger als 60 Zentimeter lang."
    },
    {
      "claim": "Der berühmte Triceratops hatte drei große Hörner am Kopf.",
      "source": "Triceratops",
      "passage": "Triceratops (von altgriechisch τρεῖς treis ‚drei‘, κέρας kéras ‚Horn‘ und ὤψ ōps ‚Antlitz‘; wörtlich also „Dreihorngesicht“)..."
    },
    {
      "claim": "Sie wanderten oft zusammen in einer großen, sicheren Gruppe.",
      "source": "Dinosaurier",
      "passage": "Vielleicht bildeten Dinosaurier Herden zur Verteidigung gegen Fressfeinde, zum Schutz der Jungtiere oder für periodische Wanderungen."
    },
    {
      "claim": "Die Mamas bauten Nester und legten dort runde Eier hinein.",
      "source": "Dinosaurier",
      "passage": "Weitere Informationen werden aus fossilen Eiern und Nestern... gewonnen."
    },
    {
      "claim": "Sie beschützten ihre kleinen Dino-Babys nach dem Schlüpfen gut.",
      "source": "Dinosaurier",
      "passage": "... zeigt, dass einige Dinosaurier ihre Jungen noch lange nach dem Schlüpfen betreuten und beschützten."
    },
    {
      "claim": "Heute finden wir versteinerte Knochen im tiefen Erdboden.",
      "source": "Fossil",
      "passage": "Ein Fossil (von lateinisch fossilis ‚ausgegraben‘...) ist jedes Zeugnis vergangenen Lebens der Erdgeschichte..."
    },
    {
      "claim": "Bestimmt kennst du auch das D auf deiner Anlauttabelle. Dort zeigt das Bild meistens einen grünen Dino.",
      "source": "Dinosaurier",
      "passage": "Bilder eines (regelmäßig grünhäutig dargestellten) Sauropoden im Stile einer Kinderbuchillustration werden in Leselern-Materialien (Anlauttabellen) als Beispielwort-Bild in der Bedeutung Dinosaurier oder Dino für den Buchstaben D verwendet..."
    },
    {
      "claim": "Wusstest du schon, dass Vögel mit den Dinos verwandt sind? Spatzen und Pinguine sind also kleine, lebendige Dinos.",
      "source": "Dinosaurier",
      "passage": "Vögel gingen aus kleinen theropoden Dinosauriern hervor. Somit sind nicht alle Dinosaurier während des Massenaussterbens am Ende des Erdmittelalters ausgestorben, sondern mit den Vögeln überlebte bis heute eine spezielle Entwicklungslinie der Dinosaurier... weisen zudem mit den Pinguinen eine Gruppe auf..."
    },
    {
      "claim": "Forscher fanden sogar im eisigen Südpol versteinere Dino-Knochen.",
      "source": "Dinosaurier",
      "passage": "Überreste von Dinosauriern sind auf allen Kontinenten gefunden worden, einschließlich der Antarktis..."
    }
  ]
