  "sections": [
    {
      "id": "sec1",
      "heading": "Die Urzeit-Riesen",
      "section_role": "intro",
      "sentences": [
        {
          "id": "s001",
          "text": "Viele denken bei Dinosauriern an riesige, grüne Monster.",
          "img_index": -1
        },
        {
          "id": "s002",
          "text": "Doch das ist nur ein Teil der Wahrheit!",
          "img_index": -1
        },
        {
          "id": "s003",
          "text": "Dinosaurier waren Tiere auf dem Land.",
          "img_index": -1
        },
        {
          "id": "s004",
          "text": "Manche hatten sogar bunte Federn wie Vögel.",
          "img_index": 0
        }
      ],
      "boxes": [],
      "table": null
    },
    {
      "id": "sec2",
      "heading": "Riesen und Zwerge",
      "section_role": "appearance_equipment",
      "sentences": [
        {
          "id": "s005",
          "text": "Einige Dinos waren so hoch wie Bäume.",
          "img_index": -1
        },
        {
          "id": "s006",
          "text": "Andere waren so klein wie ein Huhn.",
          "img_index": 1
        },
        {
          "id": "s007",
          "text": "Die großen Dinos hatten oft feste Panzer.",
          "img_index": -1
        },
        {
          "id": "s008",
          "text": "Manche trugen spitze Hörner im Gesicht.",
          "img_index": -1
        },
        {
          "id": "s009",
          "text": "Andere hatten lange Hälse für Blätter hoch oben.",
          "img_index": -1
        }
      ],
      "boxes": [
        {
          "type": "wow",
          "text": "Unglaublich: Der kleinste Dino war kleiner als ein Huhn! Er passte fast in deine Hand."
        }
      ],
      "table": null
    },
    {
      "id": "sec3",
      "heading": "Das Leben der Dinos",
      "section_role": "behavior_life",
      "sentences": [
        {
          "id": "s010",
          "text": "Alle Dinosaurier legten Eier in gemütliche Nester.",
          "img_index": -1
        },
        {
          "id": "s011",
          "text": "Sie beschützten ihre Babys warm und sicher.",
          "img_index": -1
        },
        {
          "id": "s012",
          "text": "Manche fraßen nur Pflanzen von den Bäumen.",
          "img_index": -1
        },
        {
          "id": "s013",
          "text": "Andere jagten Fleisch wie der wilde T-Rex.",
          "img_index": -1
        },
        {
          "id": "s014",
          "text": "Sie liefen flink auf zwei oder vier Beinen.",
          "img_index": -1
        }
      ],
      "boxes": [
        {
          "type": "warnung",
          "text": "Ein riesiger Stein flog aus dem All auf die Erde. Danach starben die alten Dinos leider aus."
        }
      ],
      "table": null
    },
    {
      "id": "sec4",
      "heading": "Kleine Dinos im Garten",
      "section_role": "human_animal",
      "sentences": [
        {
          "id": "s015",
          "text": "Du kannst heute noch echte Dinos sehen!",
          "img_index": -1
        },
        {
          "id": "s016",
          "text": "Kleine Vögel stammen direkt von ihnen ab.",
          "img_index": -1
        },
        {
          "id": "s017",
          "text": "Ein kleiner Spatz ist also ein Urzeit-Nachfahre.",
          "img_index": 3
        },
        {
          "id": "s018",
          "text": "Vögel sind lebendige Verwandte der alten Riesen.",
          "img_index": -1
        },
        {
          "id": "s019",
          "text": "Such mal nach dem Buchstaben D beim Lesen lernen.",
          "img_index": 2
        },
        {
          "id": "s020",
          "text": "Oft zeigt ein Bild dort einen grünen Dino!",
          "img_index": -1
        }
      ],
      "boxes": [],
      "table": null
    }
  ],
