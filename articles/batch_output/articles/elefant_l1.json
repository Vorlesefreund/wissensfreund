  "sections": [
    {
      "id": "sec1",
      "heading": "Die gemütlichen Riesen",
      "section_role": "intro",
      "sentences": [
        {
          "id": "s001",
          "text": "Viele Menschen denken bei Elefanten an graue Riesen.",
          "img_index": 0
        },
        {
          "id": "s002",
          "text": "Sie sind tatsächlich die allergrößten Landtiere der Erde.",
          "img_index": 3
        },
        {
          "id": "s003",
          "text": "Fachleute nennen sie auch Rüsseltiere.",
          "img_index": -1
        },
        {
          "id": "s004",
          "text": "Das liegt an ihrer ganz besonderen, langen Nase.",
          "img_index": -1
        },
        {
          "id": "s005",
          "text": "Sie haben auch zwei helle Stoßzähne im Gesicht.",
          "img_index": -1
        }
      ],
      "boxes": [],
      "table": null
    },
    {
      "id": "sec2",
      "heading": "Eine Nase, die alles kann",
      "section_role": "appearance_equipment",
      "sentences": [
        {
          "id": "s006",
          "text": "Der Rüssel ist die Nase und die Oberlippe zusammen.",
          "img_index": -1
        },
        {
          "id": "s007",
          "text": "Er ist so beweglich wie ein starker Arm.",
          "img_index": -1
        },
        {
          "id": "s008",
          "text": "Damit greift der Elefant nach Blättern hoch oben.",
          "img_index": -1
        },
        {
          "id": "s009",
          "text": "Oder er saugt Wasser zum Trinken auf.",
          "img_index": 4
        },
        {
          "id": "s010",
          "text": "Die riesigen Ohren helfen dem Riesen beim Abkühlen.",
          "img_index": -1
        },
        {
          "id": "s011",
          "text": "Er wedelt damit, wenn es sehr heiß ist.",
          "img_index": -1
        }
      ],
      "boxes": [],
      "table": null
    },
    {
      "id": "sec3",
      "heading": "Leben in der großen Familie",
      "section_role": "behavior_life",
      "sentences": [
        {
          "id": "s012",
          "text": "Elefantenkühe leben mit ihren Kindern in einer Gruppe.",
          "img_index": -1
        },
        {
          "id": "s013",
          "text": "Eine weise, alte Elefanten-Oma führt diese Herde an.",
          "img_index": -1
        },
        {
          "id": "s014",
          "text": "Die Babys trinken Milch bei ihrer Mutter.",
          "img_index": -1
        },
        {
          "id": "s015",
          "text": "Genau wie Kinder spielen Elefantenbabys gern im Matsch.",
          "img_index": 1
        },
        {
          "id": "s016",
          "text": "Der Schlamm schützt ihre empfindliche Haut vor Sonne.",
          "img_index": 2
        },
        {
          "id": "s017",
          "text": "Die Tiere begrüßen sich liebevoll mit ihren Rüsseln.",
          "img_index": 5
        },
        {
          "id": "s018",
          "text": "Sie umschlingen sich und halten so fest zusammen.",
          "img_index": -1
        }
      ],
      "boxes": [],
      "table": null
    },
    {
      "id": "sec4",
      "heading": "Großer Hunger und tolle Schwimmer",
      "section_role": "behavior_life",
      "sentences": [
        {
          "id": "s019",
          "text": "Ein Elefant frisst fast den ganzen Tag lang.",
          "img_index": -1
        },
        {
          "id": "s020",
          "text": "Er mampft Gräser, Blätter und saftige Rinde.",
          "img_index": -1
        },
        {
          "id": "s021",
          "text": "Beim Gehen setzt er seine Beine ganz leise auf.",
          "img_index": -1
        },
        {
          "id": "s022",
          "text": "Wusstest du, dass Elefanten auch fantastisch schwimmen können?",
          "img_index": -1
        },
        {
          "id": "s023",
          "text": "Sie paddeln im tiefen Wasser wie kleine Boote.",
          "img_index": -1
        },
        {
          "id": "s024",
          "text": "Ihr Rüssel ragt dann wie ein Schnorchel heraus.",
          "img_index": 6
        }
      ],
      "boxes": [
        {
          "type": "wow",
          "text": "Elefanten können tief im Wasser schwimmen und dabei durch ihren Rüssel wie mit einem Schnorchel atmen!"
        }
      ],
      "table": null
    },
    {
      "id": "sec5",
      "heading": "Freunde der Menschen",
      "section_role": "human_animal",
      "sentences": [
        {
          "id": "s025",
          "text": "Manche asiatischen Elefanten arbeiten eng mit Menschen zusammen.",
          "img_index": -1
        },
        {
          "id": "s026",
          "text": "Sie tragen schwere Äste aus dem dichten Wald.",
          "img_index": -1
        },
        {
          "id": "s027",
          "text": "Menschen beschützen die Riesen heute in großen Naturparks.",
          "img_index": -1
        }
      ],
      "boxes": [],
      "table": null
    }
