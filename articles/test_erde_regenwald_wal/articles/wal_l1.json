  "sections": [
    {
      "id": "sec1",
      "heading": "Wer schwimmt da im Meer?",
      "section_role": "intro",
      "sentences": [
        {
          "id": "s001",
          "text": "Stell dir ein riesiges Tier im Meer vor.",
          "img_index": 0
        },
        {
          "id": "s002",
          "text": "Es schwimmt so flink wie ein Fisch.",
          "img_index": 0
        },
        {
          "id": "s003",
          "text": "Doch es ist gar kein Fisch!",
          "img_index": 0
        },
        {
          "id": "s004",
          "text": "Es ist ein Wal.",
          "img_index": 0
        },
        {
          "id": "s005",
          "text": "Wale sind Säugetiere, genau wie wir Menschen.",
          "img_index": 0
        },
        {
          "id": "s006",
          "text": "Sie können nicht unter Wasser atmen.",
          "img_index": 0
        },
        {
          "id": "s007",
          "text": "Wale müssen Luft holen.",
          "img_index": 0
        },
        {
          "id": "s008",
          "text": "Dafür tauchen sie kurz an die Oberfläche.",
          "img_index": 0
        },
        {
          "id": "s009",
          "text": "Sie atmen tief ein.",
          "img_index": 0
        },
        {
          "id": "s010",
          "text": "Dann tauchen sie wieder in das tiefe Meer.",
          "img_index": 0
        }
      ],
      "boxes": [],
      "table": null
    },
    {
      "id": "sec2",
      "heading": "Die Riesen der Meere",
      "section_role": "appearance_equipment",
      "sentences": [
        {
          "id": "s011",
          "text": "Zum Atmen nutzen Wale ihr Blasloch.",
          "img_index": 1
        },
        {
          "id": "s012",
          "text": "Es liegt ganz oben auf ihrem Kopf.",
          "img_index": 1
        },
        {
          "id": "s013",
          "text": "Der Blauwal ist das allergrößte Tier der Erde.",
          "img_index": 1
        },
        {
          "id": "s014",
          "text": "Er ist so lang wie drei große Busse.",
          "img_index": 1
        },
        {
          "id": "s015",
          "text": "Wenn er ausatmet, pustet er eine Wolke hoch.",
          "img_index": 1
        },
        {
          "id": "s016",
          "text": "Diese Wolke fliegt sehr weit in die Luft.",
          "img_index": 1
        },
        {
          "id": "s017",
          "text": "Wale halten ihren Körper immer warm.",
          "img_index": 1
        },
        {
          "id": "s018",
          "text": "Dabei hilft ihnen eine dicke Speckschicht.",
          "img_index": 1
        },
        {
          "id": "s019",
          "text": "Fische können das nicht tun.",
          "img_index": 1
        },
        {
          "id": "s020",
          "text": "Fische haben auch eine senkrechte Schwanzflosse.",
          "img_index": 1
        },
        {
          "id": "s021",
          "text": "Die Schwanzflosse vom Wal steht aber waagerecht.",
          "img_index": 1
        }
      ],
      "boxes": [
        {
          "type": "wow",
          "text": "🌟 Ein Blauwal ist riesig! Allein sein Herz wiegt so viel wie ein kleines Auto."
        }
      ],
      "table": null
    },
    {
      "id": "sec3",
      "heading": "Babys und schlaue Helfer",
      "section_role": "behavior_life",
      "sentences": [
        {
          "id": "s022",
          "text": "Wal-Mütter gebären lebendige Babys.",
          "img_index": 2
        },
        {
          "id": "s023",
          "text": "So ein Baby heißt Kalb.",
          "img_index": 2
        },
        {
          "id": "s024",
          "text": "Das Kalb trinkt fette Milch bei der Mutter.",
          "img_index": 2
        },
        {
          "id": "s025",
          "text": "Die Mutter spritzt die Milch aktiv ins Maul.",
          "img_index": 2
        },
        {
          "id": "s026",
          "text": "Manche Wale singen sogar Lieder unter Wasser.",
          "img_index": 2
        },
        {
          "id": "s027",
          "text": "Andere Wale hören diese Lieder viele Kilometer weit.",
          "img_index": 2
        },
        {
          "id": "s028",
          "text": "Auch Delfine gehören zu den Walen.",
          "img_index": 2
        },
        {
          "id": "s029",
          "text": "Ein berühmter Delfin hieß Pelorus Jack.",
          "img_index": 2
        },
        {
          "id": "s030",
          "text": "Er schwamm oft vor Schiffen her.",
          "img_index": 2
        },
        {
          "id": "s031",
          "text": "Er zeigte ihnen den sicheren Weg durch Wellen.",
          "img_index": 2
        }
      ],
      "boxes": [
        {
          "type": "warnung",
          "text": "⚠️ Große Schiffe machen viel Lärm im Meer. Der laute Krach stört die Wale beim Rufen und Hören."
        }
      ],
      "table": null
    }
  ],
