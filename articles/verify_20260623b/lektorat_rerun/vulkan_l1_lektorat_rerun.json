  "sections": [
    {
      "id": "sec1",
      "heading": "Der Berg, der Feuer speit",
      "section_role": "intro",
      "sentences": [
        {
          "id": "s001",
          "text": "Stell dir einen ganz besonderen Berg vor.",
          "img_index": 0
        },
        {
          "id": "s002",
          "text": "Dieser Berg hat oben ein riesiges Loch.",
          "img_index": 0
        },
        {
          "id": "s003",
          "text": "Manchmal spuckt er rotes Feuer in den Himmel.",
          "img_index": 0
        },
        {
          "id": "s004",
          "text": "Das ist ein Vulkan.",
          "img_index": 0
        },
        {
          "id": "s005",
          "text": "Er funktioniert wie ein kochender Suppentopf.",
          "img_index": 0
        }
      ],
      "boxes": [],
      "table": null
    },
    {
      "id": "sec2",
      "heading": "Wie entsteht die rote Suppe?",
      "section_role": "appearance_equipment",
      "sentences": [
        {
          "id": "s006",
          "text": "Tief unter unseren Füßen ist es sehr heiß.",
          "img_index": 0
        },
        {
          "id": "s007",
          "text": "Dort schmilzt sogar fester Stein.",
          "img_index": 0
        },
        {
          "id": "s008",
          "text": "Er wird flüssig wie dicker Brei.",
          "img_index": 0
        },
        {
          "id": "s009",
          "text": "Wir nennen diesen heißen Gesteinsbrei Magma.",
          "img_index": 0
        },
        {
          "id": "s010",
          "text": "Er will unbedingt nach oben klettern.",
          "img_index": 0
        },
        {
          "id": "s011",
          "text": "Er sammelt sich in großen Kammern.",
          "img_index": 0
        },
        {
          "id": "s012",
          "text": "Es gibt viele Kammern tief im Boden.",
          "img_index": 0
        }
      ],
      "boxes": [],
      "table": null
    },
    {
      "id": "sec3",
      "heading": "Wenn der Berg spuckt",
      "section_role": "behavior_life",
      "sentences": [
        {
          "id": "s013",
          "text": "Das Magma drückt gegen die Erdoberfläche.",
          "img_index": 4
        },
        {
          "id": "s014",
          "text": "Irgendwann bricht der Berg oben auf.",
          "img_index": 4
        },
        {
          "id": "s015",
          "text": "Die rote Glut schießt ins Freie.",
          "img_index": 4
        },
        {
          "id": "s016",
          "text": "Ab jetzt heißt der rote Fluss Lava.",
          "img_index": 4
        },
        {
          "id": "s017",
          "text": "Sie kühlt an der Luft ab.",
          "img_index": 4
        },
        {
          "id": "s018",
          "text": "Dabei wird sie wieder zu festem Gestein.",
          "img_index": 4
        },
        {
          "id": "s019",
          "text": "Manchmal entsteht so ein ganz neuer Berg.",
          "img_index": 4
        },
        {
          "id": "s020",
          "text": "Er sieht oft aus wie ein spitzer Kegel.",
          "img_index": 4
        }
      ],
      "boxes": [
        {
          "type": "wow",
          "text": "🌟 Ein Vulkan spuckte Lava mitten im Meer. Aus der Lava wurde eine Insel. Sie heißt Surtsey."
        },
        {
          "type": "warnung",
          "text": "⚠️ Lava ist unglaublich heiß. Sie kann alles verbrennen. Man darf niemals nah herangehen."
        }
      ],
      "table": null
    },
    {
      "id": "sec4",
      "heading": "Spannende Wasser-Vulkane",
      "section_role": "curiosity",
      "sentences": [
        {
          "id": "s021",
          "text": "Manchmal spuckt die Erde kein Feuer.",
          "img_index": 3
        },
        {
          "id": "s022",
          "text": "Sie schießt heißes Wasser in die Luft.",
          "img_index": 3
        },
        {
          "id": "s023",
          "text": "Das sieht aus wie ein riesiger Springbrunnen.",
          "img_index": 3
        },
        {
          "id": "s024",
          "text": "Wir nennen diese warmen Quellen Geysire.",
          "img_index": 3
        },
        {
          "id": "s025",
          "text": "Sie kochen tief in der Erde.",
          "img_index": 3
        },
        {
          "id": "s026",
          "text": "Das Wasser ist auch sehr heiß.",
          "img_index": 3
        },
        {
          "id": "s027",
          "text": "Es zischt und dampft beim Ausbrechen.",
          "img_index": 3
        },
        {
          "id": "s028",
          "text": "Dann spritzen sie plötzlich hoch empor.",
          "img_index": 3
        }
      ],
      "boxes": [],
      "table": null
    }
  ],
