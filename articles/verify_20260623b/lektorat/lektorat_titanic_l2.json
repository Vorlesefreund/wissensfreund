  "sections": [
    {
      "id": "sec1",
      "heading": "Ein Riese auf dem Wasser",
      "section_role": "intro",
      "sentences": [
        {
          "id": "s001",
          "text": "Stell dir ein Schiff vor, das so hoch wie ein großes Haus ist.",
          "img_index": 0
        },
        {
          "id": "s002",
          "text": "Die Titanic war bei ihrer Fertigstellung im Jahr 1912 das größte Schiff der Welt.",
          "img_index": 0
        },
        {
          "id": "s003",
          "text": "Dieser riesige britische Dampfer sollte Passagiere und Post sicher über den Atlantik bringen.",
          "img_index": 1
        },
        {
          "id": "s004",
          "text": "Am 10. April startete sie voller Stolz zu ihrer allerersten Fahrt nach New York.",
          "img_index": 1
        }
      ],
      "boxes": [],
      "table": null
    },
    {
      "id": "sec2",
      "heading": "Ein Eisberg im Dunkeln",
      "section_role": "process_how",
      "sentences": [
        {
          "id": "s005",
          "text": "Die Reise endete schon nach wenigen Tagen im kalten Nordatlantik.",
          "img_index": 2
        },
        {
          "id": "s006",
          "text": "In einer dunklen Nacht stieß die Titanic mit einem riesigen Eisberg zusammen.",
          "img_index": 2
        },
        {
          "id": "s007",
          "text": "Der harte Eisberg riss mehrere Löcher unter Wasser in die dicke Außenwand aus Stahl.",
          "img_index": 2
        },
        {
          "id": "s008",
          "text": "Nun strömte unaufhaltsam kaltes Meerwasser in das Innere des Schiffes.",
          "img_index": 2
        },
        {
          "id": "s009",
          "text": "Da es nicht genug Rettungsboote für alle Menschen gab, war die Not groß.",
          "img_index": 2
        },
        {
          "id": "s010",
          "text": "Nach etwa zweieinhalb Stunden zerbrach der Riese in zwei Teile und versank völlig im Meer.",
          "img_index": 2
        }
      ],
      "boxes": [
        {
          "type": "warnung",
          "text": "Bei diesem schweren Unglück starben mehr als 1500 Menschen. Danach wurden neue, strengere Sicherheitsregeln für Schiffe auf der ganzen Welt beschlossen."
        }
      ],
      "table": null
    },
    {
      "id": "sec3",
      "heading": "Hilfe in der Not",
      "section_role": "historical_context",
      "sentences": [
        {
          "id": "s011",
          "text": "Zum Glück hatte die Titanic eine Funkstation und konnte Notrufe an andere Schiffe senden.",
          "img_index": 3
        },
        {
          "id": "s012",
          "text": "Das Schiff Carpathia hörte den Ruf und eilte sofort zur Hilfe.",
          "img_index": 3
        },
        {
          "id": "s013",
          "text": "Die Carpathia rettete die Menschen aus den Booten und brachte sie sicher nach New York.",
          "img_index": 3
        },
        {
          "id": "s014",
          "text": "Unter den Geretteten war auch das Baby Millvina Dean, das damals erst zehn Wochen alt war.",
          "img_index": 3
        }
      ],
      "boxes": [
        {
          "type": "wow",
          "text": "Die Küche der Titanic hatte riesige Kochstellen mit 19 Backöfen! Die Vorräte an Fleisch und Fisch wogen über 72 Tonnen – so viel wie 70 kleine Autos."
        }
      ],
      "table": null
    },
    {
      "id": "sec4",
      "heading": "Die Suche in der Tiefsee",
      "section_role": "today_legacy",
      "sentences": [
        {
          "id": "s015",
          "text": "Viele Jahre lang lag das zerbrochene Schiff unbemerkt am dunklen Meeresboden.",
          "img_index": 4
        },
        {
          "id": "s016",
          "text": "Im Jahr 1985 entdeckte der Meeresforscher Robert Ballard das Wrack, also die Trümmer der Titanic.",
          "img_index": 4
        },
        {
          "id": "s017",
          "text": "Das war eine weltweite Sensation!",
          "img_index": 4
        },
        {
          "id": "s018",
          "text": "Heute nagen winzige Bakterien am Metall des Wracks, sodass es irgendwann ganz zerfallen wird.",
          "img_index": 4
        }
      ],
      "boxes": [],
      "table": null
    }
