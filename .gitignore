cost_log.json
cost_log.json.bak

# Lektorat Re-Run Outputs (Test-Artefakte)
articles/*/lektorat_rerun/

# Word-Dokumente (Review-Output, reproduzierbar — nicht tracken)
*.docx
~$*.docx
~$*.xlsx

# Laufzeit-Status-Log (append-only, unbeaufsichtigter Batch-Betrieb) — nicht tracken
run_status.jsonl
# Verfügbarkeits-Messungen flash_monitor.py (append-only, Laufzeit-Artefakt) — nicht tracken
flash_monitor.jsonl
# Task-Scheduler-Lauf-Log flash_monitor (append, Laufzeit-Artefakt) — nicht tracken
flash_monitor_task.log

# Test-Ordner generalize_test — lokal behalten, nicht tracken
articles/generalize_test/

