#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android NDK / CMake build cache
android/app/.cxx/

# Android local SDK paths (machine-specific)
android/local.properties

# ZIM knowledge base (large binary, distributed separately)
*.zim

# Secrets / Credentials
.env

# Pipeline outputs / large local data (nicht versionieren, Dateien bleiben lokal)
scrape_out/
dry_run_out/
scrape_image_results.json
dumpstate-*.zip
articles/**/_review.html
cost_log.json
cost_log.json.bak

# Lektorat Re-Run Outputs (Test-Artefakte)
articles/*/lektorat_rerun/

# Word-Dokumente (Review-Output, reproduzierbar — nicht tracken)
*.docx
~$*.docx
~$*.xlsx
